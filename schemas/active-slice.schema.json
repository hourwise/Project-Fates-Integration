{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./active-slice.schema.json",
  "title": "Active Slice",
  "description": "Records the currently active vertical integration slice.",
  "type": "object",
  "required": ["status", "activeSliceId", "baselineCompatibilitySet", "activationRequirements"],
  "properties": {
    "$schema": { "type": "string" },
    "status": { "type": "string", "enum": ["idle", "active"] },
    "activeSliceId": {
      "type": ["string", "null"],
      "pattern": "^(FATES-SLICE-\\d{3}|null)$"
    },
    "baselineCompatibilitySet": { "type": "string" },
    "nextRecommendedSlice": { "type": ["string", "null"] },
    "activationRequirements": {
      "type": "object",
      "required": ["acceptedScope", "ownerOrder", "acceptanceCriteria", "startingCheckpoints", "userAuthorisation"],
      "properties": {
        "acceptedScope": { "type": "string" },
        "ownerOrder": { "type": "string" },
        "acceptanceCriteria": { "type": "string" },
        "startingCheckpoints": { "type": "string" },
        "userAuthorisation": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "idle" } } },
      "then": { "properties": { "activeSliceId": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "active" } } },
      "then": {
        "required": ["nextRecommendedSlice"],
        "properties": {
          "activeSliceId": { "type": "string", "pattern": "^FATES-SLICE-\\d{3}$" }
        }
      }
    }
  ]
}
