{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./compatibility-matrix.schema.json",
  "title": "Compatibility Matrix",
  "description": "Records vertical integration slice compatibility across the Fates ecosystem.",
  "type": "object",
  "required": ["compatibilitySetId", "rows"],
  "properties": {
    "$schema": { "type": "string" },
    "compatibilitySetId": { "type": "string" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sliceId", "title", "implementationStatus", "sealStatus"],
        "properties": {
          "sliceId": { "type": "string", "pattern": "^FATES-SLICE-\\d{3}$" },
          "title": { "type": "string" },
          "implementationStatus": {
            "type": "string",
            "enum": ["planned", "active", "implemented", "completed", "superseded"]
          },
          "sealStatus": {
            "type": "string",
            "enum": ["provisional", "sealed", "superseded"]
          },
          "integrationLevel": {
            "type": ["string", "null"],
            "enum": ["inspection_only", "partial_runtime", "runtime_validated", null]
          },
          "compatibilitySet": { "type": "string" },
          "repositories": { "type": "object" },
          "explicitLimits": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "implementationStatus": { "const": "planned" } } },
            "then": {
              "properties": {
                "repositories": { "type": "null" },
                "compatibilitySet": { "type": "null" },
                "explicitLimits": { "type": "null" },
                "integrationLevel": { "type": "null" }
              }
            }
          },
          {
            "if": {
              "properties": { "implementationStatus": { "enum": ["completed", "implemented"] } }
            },
            "then": {
              "required": ["compatibilitySet", "integrationLevel"]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
